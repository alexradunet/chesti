    "lifeapps": "bun scripts/lifeapps.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.86.1",
    "@fontsource-variable/ibm-plex-sans": "^5.2.8",
    "hono": "^4.13.9",
    "mdast-util-from-markdown": "^2.0.3",
    "typebox": "1.3.34",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.0"
  }
