{
  "name": "taskdesk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A tiny hypermedia-first, Pi-composed issue desk.",
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "check": "tsc --noEmit",
